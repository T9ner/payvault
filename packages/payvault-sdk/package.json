{
  "name": "payvault-sdk",
  "version": "1.0.0",
  "description": "DEPRECATED: payvault-sdk has moved to quirk-sdk. Please install quirk-sdk instead.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts --format cjs,esm --dts --clean --external crypto",
    "lint": "npx tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "payvault",
    "quirk",
    "payments",
    "africa"
  ],
  "author": "Quirk <dbosshonour@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/T9ner/quirk.git",
    "directory": "packages/payvault-sdk"
  },
  "dependencies": {
    "quirk-sdk": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^1.6.1"
  }
}
