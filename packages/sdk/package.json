{
  "name": "quirk-sdk",
  "version": "1.0.0",
  "description": "Developer-first payment infrastructure SDK for African technology companies. One unified API for multi-rail payments, cards, virtual accounts, USSD, and mobile money with autonomous failover.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./checkout": "./checkout/quirk-checkout.js",
    "./checkout/styles": "./checkout/quirk-checkout.css"
  },
  "files": [
    "dist",
    "checkout/quirk-checkout.js",
    "checkout/quirk-checkout.css",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts --format cjs,esm --dts --clean --external crypto",
    "dev": "npx tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "npx tsc --noEmit",
    "prepublishOnly": "npx tsup src/index.ts --format cjs,esm --dts --clean --external crypto",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc --skipErrorChecking"
  },
  "keywords": [
    "payments",
    "quirk",
    "paystack",
    "flutterwave",
    "monnify",
    "squad",
    "africa",
    "fintech",
    "checkout",
    "virtual-accounts",
    "failover",
    "sdk"
  ],
  "author": "Quirk Engineering <dbosshonour@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/T9ner/quirk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/T9ner/quirk/issues"
  },
  "homepage": "https://quirk-three.vercel.app/",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
