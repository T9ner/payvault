{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd apps/dashboard && pnpm install",
  "buildCommand": "cd apps/dashboard && pnpm run build",
  "outputDirectory": "apps/dashboard/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
